{
  "name": "skill-bench-runner",
  "version": "1.0.0",
  "description": "LLM router benchmark runner for skill-bench.md",
  "type": "module",
  "scripts": {
    "mock": "tsx run.ts --suite routing-flat --provider mock --model mock",
    "mock:progressive": "tsx run.ts --suite loading-progressive --provider mock --model mock",
    "bench:openai": "tsx run.ts --suite routing-flat --provider openai --model gpt-4o --key $OPENAI_API_KEY",
    "bench:openai:progressive": "tsx run.ts --suite loading-progressive --provider openai --model gpt-4o --key $OPENAI_API_KEY",
    "bench:anthropic": "tsx run.ts --suite routing-flat --provider anthropic --model claude-3-7-sonnet-20250219 --key $ANTHROPIC_API_KEY",
    "bench:anthropic:progressive": "tsx run.ts --suite loading-progressive --provider anthropic --model claude-3-7-sonnet-20250219 --key $ANTHROPIC_API_KEY",
    "bench:gemini": "tsx run.ts --suite routing-flat --provider gemini --model gemini-2.0-flash --key $GEMINI_API_KEY",
    "bench:gemini:progressive": "tsx run.ts --suite loading-progressive --provider gemini --model gemini-2.0-flash --key $GEMINI_API_KEY"
  },
  "dependencies": {},
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
