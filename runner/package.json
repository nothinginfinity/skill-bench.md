{
  "name": "skill-bench-runner",
  "version": "1.4.0",
  "description": "LLM router benchmark runner for skill-bench.md",
  "type": "module",
  "scripts": {
    "// ─── MOCK ─────────────────────────────────────────────────────────────": "",
    "mock":                       "tsx run.ts --suite routing-flat    --mode echo --provider mock --model mock",
    "mock:format":                "tsx run.ts --suite routing-format              --provider mock --model mock",
    "mock:seeded":                "tsx run.ts --suite routing-seeded              --provider mock --model mock",
    "mock:progressive":           "tsx run.ts --suite loading-progressive         --provider mock --model mock",
    "smoke":                      "tsx run.ts --suite routing-flat    --mode echo --provider mock --model mock --limit 10",
    "smoke:format":               "tsx run.ts --suite routing-format              --provider mock --model mock --limit 10",

    "// ─── OpenAI (concurrency 5) ──────────────────────────────────────────": "",
    "bench:openai:echo":          "tsx run.ts --suite routing-flat    --mode echo    --provider openai --model gpt-4o --key $OPENAI_API_KEY --concurrency 5",
    "bench:openai:recall":        "tsx run.ts --suite routing-flat    --mode recall  --provider openai --model gpt-4o --key $OPENAI_API_KEY --concurrency 5",
    "bench:openai:format":        "tsx run.ts --suite routing-format               --provider openai --model gpt-4o --key $OPENAI_API_KEY --concurrency 5",
    "bench:openai:seeded":        "tsx run.ts --suite routing-seeded               --provider openai --model gpt-4o --key $OPENAI_API_KEY --concurrency 5",
    "bench:openai:progressive":   "tsx run.ts --suite loading-progressive          --provider openai --model gpt-4o --key $OPENAI_API_KEY --concurrency 5",

    "// ─── Anthropic (concurrency 5) ───────────────────────────────────────": "",
    "bench:anthropic:echo":       "tsx run.ts --suite routing-flat    --mode echo    --provider anthropic --model claude-3-7-sonnet-20250219 --key $ANTHROPIC_API_KEY --concurrency 5",
    "bench:anthropic:format":     "tsx run.ts --suite routing-format               --provider anthropic --model claude-3-7-sonnet-20250219 --key $ANTHROPIC_API_KEY --concurrency 5",
    "bench:anthropic:seeded":     "tsx run.ts --suite routing-seeded               --provider anthropic --model claude-3-7-sonnet-20250219 --key $ANTHROPIC_API_KEY --concurrency 5",
    "bench:anthropic:progressive":"tsx run.ts --suite loading-progressive          --provider anthropic --model claude-3-7-sonnet-20250219 --key $ANTHROPIC_API_KEY --concurrency 5",

    "// ─── Gemini (concurrency 5) ──────────────────────────────────────────": "",
    "bench:gemini:echo":          "tsx run.ts --suite routing-flat    --mode echo    --provider gemini --model gemini-2.0-flash --key $GEMINI_API_KEY --concurrency 5",
    "bench:gemini:format":        "tsx run.ts --suite routing-format               --provider gemini --model gemini-2.0-flash --key $GEMINI_API_KEY --concurrency 5",
    "bench:gemini:seeded":        "tsx run.ts --suite routing-seeded               --provider gemini --model gemini-2.0-flash --key $GEMINI_API_KEY --concurrency 5",
    "bench:gemini:progressive":   "tsx run.ts --suite loading-progressive          --provider gemini --model gemini-2.0-flash --key $GEMINI_API_KEY --concurrency 5",

    "// ─── DeepSeek (concurrency 3) ────────────────────────────────────────": "",
    "bench:deepseek:echo":        "tsx run.ts --suite routing-flat    --mode echo    --provider deepseek --model deepseek-reasoner --key $DEEPSEEK_API_KEY --concurrency 3",
    "bench:deepseek:format":      "tsx run.ts --suite routing-format               --provider deepseek --model deepseek-reasoner --key $DEEPSEEK_API_KEY --concurrency 3",
    "bench:deepseek:seeded":      "tsx run.ts --suite routing-seeded               --provider deepseek --model deepseek-reasoner --key $DEEPSEEK_API_KEY --concurrency 3",
    "bench:deepseek:progressive": "tsx run.ts --suite loading-progressive          --provider deepseek --model deepseek-reasoner --key $DEEPSEEK_API_KEY --concurrency 3",

    "// ─── Groq FREE TIER (concurrency 1, delay 2000 — do not increase) ───": "",
    "bench:groq:echo":            "tsx run.ts --suite routing-flat    --mode echo    --provider groq --model llama-3.1-8b-instant   --key $GROQ_API_KEY --concurrency 1 --delay 2000",
    "bench:groq:recall":          "tsx run.ts --suite routing-flat    --mode recall  --provider groq --model llama-3.1-8b-instant   --key $GROQ_API_KEY --concurrency 1 --delay 2000",
    "bench:groq:format":          "tsx run.ts --suite routing-format               --provider groq --model llama-3.1-8b-instant   --key $GROQ_API_KEY --concurrency 1 --delay 2000",
    "bench:groq:seeded":          "tsx run.ts --suite routing-seeded               --provider groq --model llama-3.1-8b-instant   --key $GROQ_API_KEY --concurrency 1 --delay 2000",
    "bench:groq:70b:echo":        "tsx run.ts --suite routing-flat    --mode echo    --provider groq --model llama-3.3-70b-versatile --key $GROQ_API_KEY --concurrency 1 --delay 2000",
    "bench:groq:70b:format":      "tsx run.ts --suite routing-format               --provider groq --model llama-3.3-70b-versatile --key $GROQ_API_KEY --concurrency 1 --delay 2000",
    "bench:groq:progressive":     "tsx run.ts --suite loading-progressive          --provider groq --model llama-3.1-8b-instant   --key $GROQ_API_KEY --concurrency 1 --delay 2000",

    "// ─── Cerebras FREE TIER (concurrency 1, delay 2000 — do not increase)": "",
    "bench:cerebras:echo":        "tsx run.ts --suite routing-flat    --mode echo    --provider cerebras --model llama3.1-8b  --key $CEREBRAS_API_KEY --concurrency 1 --delay 2000",
    "bench:cerebras:format":      "tsx run.ts --suite routing-format               --provider cerebras --model llama3.1-8b  --key $CEREBRAS_API_KEY --concurrency 1 --delay 2000",
    "bench:cerebras:seeded":      "tsx run.ts --suite routing-seeded               --provider cerebras --model llama3.1-8b  --key $CEREBRAS_API_KEY --concurrency 1 --delay 2000",
    "bench:cerebras:70b:echo":    "tsx run.ts --suite routing-flat    --mode echo    --provider cerebras --model llama3.3-70b --key $CEREBRAS_API_KEY --concurrency 1 --delay 2000",
    "bench:cerebras:70b:format":  "tsx run.ts --suite routing-format               --provider cerebras --model llama3.3-70b --key $CEREBRAS_API_KEY --concurrency 1 --delay 2000"
  },
  "dependencies": {},
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
